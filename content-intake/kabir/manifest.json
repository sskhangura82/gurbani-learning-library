          "sourceOrdinal": 1,
          "sourcePrintedLine": 1,
          "sourceWithinLine": 1,
          "text": "ਮੁਕਤਿ ਪਦਾਰਥੁ ਪਾਈਐ ਠਾਕ ਨ ਅਵਘਟ ਘਾਟ ॥੨੩੧॥",
          "textSha256": "1e4a9e3a774c6e37e1e9f8cec49a71896a4f4380c29494fd2c8f21b2b4bb8d94"
        },
        "next": {
          "sourceAng": 1377,
          "sourcePath": "corpus/ang-1377.md",
          "sourceGitBlob": "2517993def728500a63090f00e80e4746592fbfb",
          "sourceOrdinal": 3,
          "sourcePrintedLine": 2,
