{
  "rows": [
    {
      "ang": 1426,
      "sourceRow": 16,
      "sourceAngLine": 9,
      "text": "ੴ ਸਤਿਗੁਰ ਪ੍ਰਸਾਦਿ ॥"
    },
    {
      "ang": 1426,
      "sourceRow": 17,
      "sourceAngLine": 10,
      "text": "ਸਲੋਕ ਮਹਲਾ ੯ ॥"
    },
    {
      "ang": 1426,
      "sourceRow": 18,
      "sourceAngLine": 10,
      "text": "ਗੁਨ ਗੋਬਿੰਦ ਗਾਇਓ ਨਹੀ ਜਨਮੁ ਅਕਾਰਥ ਕੀਨੁ ॥"
    },
    {
      "ang": 1426,
      "sourceRow": 19,
      "sourceAngLine": 10,
      "text": "ਕਹੁ ਨਾਨਕ ਹਰਿ ਭਜੁ ਮਨਾ ਜਿਹ ਬਿਧਿ ਜਲ ਕਉ ਮੀਨੁ ॥੧॥"
    },
    {
      "ang": 1426,
      "sourceRow": 20,
      "sourceAngLine": 11,
      "text": "ਬਿਖਿਅਨ ਸਿਉ ਕਾਹੇ ਰਚਿਓ ਨਿਮਖ ਨ ਹੋਹਿ ਉਦਾਸੁ ॥"
    },
    {
      "ang": 1426,
      "sourceRow": 21,
      "sourceAngLine": 11,
      "text": "ਕਹੁ ਨਾਨਕ ਭਜੁ ਹਰਿ ਮਨਾ ਪਰੈ ਨ ਜਮ ਕੀ ਫਾਸ ॥੨॥"
    },
    {
      "ang": 1426,
      "sourceRow": 22,
      "sourceAngLine": 12,
      "text": "ਤਰਨਾਪੋ ਇਉ ਹੀ ਗਇਓ ਲੀਓ ਜਰਾ ਤਨੁ ਜੀਤਿ ॥"
    },
    {
      "ang": 1426,
      "sourceRow": 23,
      "sourceAngLine": 12,
      "text": "ਕਹੁ ਨਾਨਕ ਭਜੁ ਹਰਿ ਮਨਾ ਅਉਧ ਜਾਤੁ ਹੈ ਬੀਤਿ ॥੩॥"
    },
    {
      "ang": 1426,
      "sourceRow": 24,
      "sourceAngLine": 13,
      "text": "ਬਿਰਧਿ ਭਇਓ ਸੂਝੈ ਨਹੀ ਕਾਲੁ ਪਹੂਚਿਓ ਆਨਿ ॥"
    },
    {
      "ang": 1426,
      "sourceRow": 25,
      "sourceAngLine": 13,
      "text": "ਕਹੁ ਨਾਨਕ ਨਰ ਬਾਵਰੇ ਕਿਉ ਨ ਭਜੈ ਭਗਵਾਨੁ ॥੪॥"
    },
    {
      "ang": 1426,
      "sourceRow": 26,
      "sourceAngLine": 14,
      "text": "ਧਨੁ ਦਾਰਾ ਸੰਪਤਿ ਸਗਲ ਜਿਨਿ ਅਪੁਨੀ ਕਰਿ ਮਾਨਿ ॥"
    },
    {
      "ang": 1426,
      "sourceRow": 27,
      "sourceAngLine": 14,
      "text": "ਇਨ ਮੈ ਕਛੁ ਸੰਗੀ ਨਹੀ ਨਾਨਕ ਸਾਚੀ ਜਾਨਿ ॥੫॥"
    },
    {
      "ang": 1426,
      "sourceRow": 28,
      "sourceAngLine": 15,
      "text": "ਪਤਿਤ ਉਧਾਰਨ ਭੈ ਹਰਨ ਹਰਿ ਅਨਾਥ ਕੇ ਨਾਥ ॥"
    },
    {
      "ang": 1426,
      "sourceRow": 29,
      "sourceAngLine": 15,
      "text": "ਕਹੁ ਨਾਨਕ ਤਿਹ ਜਾਨੀਐ ਸਦਾ ਬਸਤੁ ਤੁਮ ਸਾਥਿ ॥੬॥"
    },
    {
      "ang": 1426,
      "sourceRow": 30,
      "sourceAngLine": 16,
      "text": "ਤਨੁ ਧਨੁ ਜਿਹ ਤੋ ਕਉ ਦੀਓ ਤਾਂ ਸਿਉ ਨੇਹੁ ਨ ਕੀਨ ॥"
    },
    {
      "ang": 1426,
      "sourceRow": 31,
      "sourceAngLine": 16,
      "text": "ਕਹੁ ਨਾਨਕ ਨਰ ਬਾਵਰੇ ਅਬ ਕਿਉ ਡੋਲਤ ਦੀਨ ॥੭॥"
    },
    {
      "ang": 1426,
      "sourceRow": 32,
      "sourceAngLine": 17,
      "text": "ਤਨੁ ਧਨੁ ਸੰਪੈ ਸੁਖ ਦੀਓ ਅਰੁ ਜਿਹ ਨੀਕੇ ਧਾਮ ॥"
    },
    {
      "ang": 1426,
      "sourceRow": 33,
      "sourceAngLine": 17,
      "text": "ਕਹੁ ਨਾਨਕ ਸੁਨੁ ਰੇ ਮਨਾ ਸਿਮਰਤ ਕਾਹਿ ਨ ਰਾਮੁ ॥੮॥"
    },
    {
      "ang": 1426,
      "sourceRow": 34,
      "sourceAngLine": 18,
      "text": "ਸਭ ਸੁਖ ਦਾਤਾ ਰਾਮੁ ਹੈ ਦੂਸਰ ਨਾਹਿਨ ਕੋਇ ॥"
    },
    {
      "ang": 1426,
      "sourceRow": 35,
      "sourceAngLine": 18,
      "text": "ਕਹੁ ਨਾਨਕ ਸੁਨਿ ਰੇ ਮਨਾ ਤਿਹ ਸਿਮਰਤ ਗਤਿ ਹੋਇ ॥੯॥"
    },
    {
      "ang": 1427,
      "sourceRow": 1,
      "sourceAngLine": 1,
      "text": "ਜਿਹ ਸਿਮਰਤ ਗਤਿ ਪਾਈਐ ਤਿਹ ਭਜੁ ਰੇ ਤੈ ਮੀਤ ॥"
    },
    {
      "ang": 1427,
      "sourceRow": 2,
      "sourceAngLine": 1,
      "text": "ਕਹੁ ਨਾਨਕ ਸੁਨੁ ਰੇ ਮਨਾ ਅਉਧ ਘਟਤ ਹੈ ਨੀਤ ॥੧੦॥"
    },
    {
      "ang": 1427,
      "sourceRow": 3,
      "sourceAngLine": 2,
      "text": "ਪਾਂਚ ਤਤ ਕੋ ਤਨੁ ਰਚਿਓ ਜਾਨਹੁ ਚਤੁਰ ਸੁਜਾਨ ॥"
    },
    {
      "ang": 1427,
      "sourceRow": 4,
      "sourceAngLine": 2,
      "text": "ਜਿਹ ਤੇ ਉਪਜਿਓ ਨਾਨਕਾ ਲੀਨ ਤਾਹਿ ਮੈ ਮਾਨੁ ॥੧੧॥"
    },
    {
      "ang": 1427,
      "sourceRow": 5,
      "sourceAngLine": 3,
      "text": "ਘਟ ਘਟ ਮੈ ਹਰਿ ਜੂ ਬਸੈ ਸੰਤਨ ਕਹਿਓ ਪੁਕਾਰਿ ॥"
    },
    {
      "ang": 1427,
      "sourceRow": 6,
      "sourceAngLine": 3,
      "text": "ਕਹੁ ਨਾਨਕ ਤਿਹ ਭਜੁ ਮਨਾ ਭਉ ਨਿਧਿ ਉਤਰਹਿ ਪਾਰਿ ॥੧੨॥"
    },
    {
      "ang": 1427,
      "sourceRow": 7,
      "sourceAngLine": 4,
      "text": "ਸੁਖੁ ਦੁਖੁ ਜਿਹ ਪਰਸੈ ਨਹੀ ਲੋਭੁ ਮੋਹੁ ਅਭਿਮਾਨੁ ॥"
    },
    {
      "ang": 1427,
      "sourceRow": 8,
      "sourceAngLine": 4,
      "text": "ਕਹੁ ਨਾਨਕ ਸੁਨੁ ਰੇ ਮਨਾ ਸੋ ਮੂਰਤਿ ਭਗਵਾਨ ॥੧੩॥"
    },
    {
      "ang": 1427,
      "sourceRow": 9,
      "sourceAngLine": 5,
      "text": "ਉਸਤਤਿ ਨਿੰਦਿਆ ਨਾਹਿ ਜਿਹਿ ਕੰਚਨ ਲੋਹ ਸਮਾਨਿ ॥"
    },
    {
      "ang": 1427,
      "sourceRow": 10,
      "sourceAngLine": 5,
      "text": "ਕਹੁ ਨਾਨਕ ਸੁਨਿ ਰੇ ਮਨਾ ਮੁਕਤਿ ਤਾਹਿ ਤੈ ਜਾਨਿ ॥੧੪॥"
    },
    {
      "ang": 1427,
      "sourceRow": 11,
      "sourceAngLine": 6,
      "text": "ਹਰਖੁ ਸੋਗੁ ਜਾ ਕੈ ਨਹੀ ਬੈਰੀ ਮੀਤ ਸਮਾਨਿ ॥"
    },
    {
      "ang": 1427,
      "sourceRow": 12,
      "sourceAngLine": 6,
      "text": "ਕਹੁ ਨਾਨਕ ਸੁਨਿ ਰੇ ਮਨਾ ਮੁਕਤਿ ਤਾਹਿ ਤੈ ਜਾਨਿ ॥੧੫॥"
    },
    {
      "ang": 1427,
      "sourceRow": 13,
      "sourceAngLine": 7,
      "text": "ਭੈ ਕਾਹੂ ਕਉ ਦੇਤ ਨਹਿ ਨਹਿ ਭੈ ਮਾਨਤ ਆਨ ॥"
    },
    {
      "ang": 1427,
      "sourceRow": 14,
      "sourceAngLine": 7,
      "text": "ਕਹੁ ਨਾਨਕ ਸੁਨਿ ਰੇ ਮਨਾ ਗਿਆਨੀ ਤਾਹਿ ਬਖਾਨਿ ॥੧੬॥"
    },
    {
      "ang": 1427,
      "sourceRow": 15,
      "sourceAngLine": 8,
      "text": "ਜਿਹਿ ਬਿਖਿਆ ਸਗਲੀ ਤਜੀ ਲੀਓ ਭੇਖ ਬੈਰਾਗ ॥"
    },
    {
      "ang": 1427,
      "sourceRow": 16,
      "sourceAngLine": 8,
      "text": "ਕਹੁ ਨਾਨਕ ਸੁਨੁ ਰੇ ਮਨਾ ਤਿਹ ਨਰ ਮਾਥੈ ਭਾਗੁ ॥੧੭॥"
    },
    {
      "ang": 1427,
      "sourceRow": 17,
      "sourceAngLine": 9,
      "text": "ਜਿਹਿ ਮਾਇਆ ਮਮਤਾ ਤਜੀ ਸਭ ਤੇ ਭਇਓ ਉਦਾਸੁ ॥"
    },
    {
      "ang": 1427,
      "sourceRow": 18,
      "sourceAngLine": 9,
      "text": "ਕਹੁ ਨਾਨਕ ਸੁਨੁ ਰੇ ਮਨਾ ਤਿਹ ਘਟਿ ਬ੍ਰਹਮ ਨਿਵਾਸੁ ॥੧੮॥"
    },
    {
      "ang": 1427,
      "sourceRow": 19,
      "sourceAngLine": 10,
      "text": "ਜਿਹਿ ਪ੍ਰਾਨੀ ਹਉਮੈ ਤਜੀ ਕਰਤਾ ਰਾਮੁ ਪਛਾਨਿ ॥"
    },
    {
      "ang": 1427,
      "sourceRow": 20,
      "sourceAngLine": 10,
      "text": "ਕਹੁ ਨਾਨਕ ਵਹੁ ਮੁਕਤਿ ਨਰੁ ਇਹ ਮਨ ਸਾਚੀ ਮਾਨੁ ॥੧੯॥"
    },
    {
      "ang": 1427,
      "sourceRow": 21,
      "sourceAngLine": 11,
      "text": "ਭੈ ਨਾਸਨ ਦੁਰਮਤਿ ਹਰਨ ਕਲਿ ਮੈ ਹਰਿ ਕੋ ਨਾਮੁ ॥"
    },
    {
      "ang": 1427,
      "sourceRow": 22,
      "sourceAngLine": 11,
      "text": "ਨਿਸਿ ਦਿਨੁ ਜੋ ਨਾਨਕ ਭਜੈ ਸਫਲ ਹੋਹਿ ਤਿਹ ਕਾਮ ॥੨੦॥"
    },
    {
      "ang": 1427,
      "sourceRow": 23,
      "sourceAngLine": 12,
      "text": "ਜਿਹਬਾ ਗੁਨ ਗੋਬਿੰਦ ਭਜਹੁ ਕਰਨ ਸੁਨਹੁ ਹਰਿ ਨਾਮੁ ॥"
    },
    {
      "ang": 1427,
      "sourceRow": 24,
      "sourceAngLine": 12,
      "text": "ਕਹੁ ਨਾਨਕ ਸੁਨਿ ਰੇ ਮਨਾ ਪਰਹਿ ਨ ਜਮ ਕੈ ਧਾਮ ॥੨੧॥"
    },
    {
      "ang": 1427,
      "sourceRow": 25,
      "sourceAngLine": 13,
      "text": "ਜੋ ਪ੍ਰਾਨੀ ਮਮਤਾ ਤਜੈ ਲੋਭ ਮੋਹ ਅਹੰਕਾਰ ॥"
    },
    {
      "ang": 1427,
      "sourceRow": 26,
      "sourceAngLine": 13,
      "text": "ਕਹੁ ਨਾਨਕ ਆਪਨ ਤਰੈ ਅਉਰਨ ਲੇਤ ਉਧਾਰ ॥੨੨॥"
    },
    {
      "ang": 1427,
      "sourceRow": 27,
      "sourceAngLine": 14,
      "text": "ਜਿਉ ਸੁਪਨਾ ਅਰੁ ਪੇਖਨਾ ਐਸੇ ਜਗ ਕਉ ਜਾਨਿ ॥"
    },
    {
      "ang": 1427,
      "sourceRow": 28,
      "sourceAngLine": 14,
      "text": "ਇਨ ਮੈ ਕਛੁ ਸਾਚੋ ਨਹੀ ਨਾਨਕ ਬਿਨੁ ਭਗਵਾਨ ॥੨੩॥"
    },
    {
      "ang": 1427,
      "sourceRow": 29,
      "sourceAngLine": 15,
      "text": "ਨਿਸਿ ਦਿਨੁ ਮਾਇਆ ਕਾਰਨੇ ਪ੍ਰਾਨੀ ਡੋਲਤ ਨੀਤ ॥"
    },
    {
      "ang": 1427,
      "sourceRow": 30,
      "sourceAngLine": 15,
      "text": "ਕੋਟਨ ਮੈ ਨਾਨਕ ਕੋਊ ਨਾਰਾਇਨੁ ਜਿਹ ਚੀਤਿ ॥੨੪॥"
    },
    {
      "ang": 1427,
      "sourceRow": 31,
      "sourceAngLine": 16,
      "text": "ਜੈਸੇ ਜਲ ਤੇ ਬੁਦਬੁਦਾ ਉਪਜੈ ਬਿਨਸੈ ਨੀਤ ॥"
    },
    {
      "ang": 1427,
      "sourceRow": 32,
      "sourceAngLine": 16,
      "text": "ਜਗ ਰਚਨਾ ਤੈਸੇ ਰਚੀ ਕਹੁ ਨਾਨਕ ਸੁਨਿ ਮੀਤ ॥੨੫॥"
    },
    {
      "ang": 1427,
      "sourceRow": 33,
      "sourceAngLine": 16,
      "text": "ਪ੍ਰਾਨੀ ਕਛੂ ਨ ਚੇਤਈ ਮਦਿ ਮਾਇਆ ਕੈ ਅੰਧੁ ॥"
    },
    {
      "ang": 1427,
      "sourceRow": 34,
      "sourceAngLine": 17,
      "text": "ਕਹੁ ਨਾਨਕ ਬਿਨੁ ਹਰਿ ਭਜਨ ਪਰਤ ਤਾਹਿ ਜਮ ਫੰਧ ॥੨੬॥"
    },
    {
      "ang": 1427,
      "sourceRow": 35,
      "sourceAngLine": 17,
      "text": "ਜਉ ਸੁਖ ਕਉ ਚਾਹੈ ਸਦਾ ਸਰਨਿ ਰਾਮ ਕੀ ਲੇਹ ॥"
    },
    {
      "ang": 1427,
      "sourceRow": 36,
      "sourceAngLine": 18,
      "text": "ਕਹੁ ਨਾਨਕ ਸੁਨਿ ਰੇ ਮਨਾ ਦੁਰਲਭ ਮਾਨੁਖ ਦੇਹ ॥੨੭॥"
    },
    {
      "ang": 1427,
      "sourceRow": 37,
      "sourceAngLine": 18,
      "text": "ਮਾਇਆ ਕਾਰਨਿ ਧਾਵਹੀ ਮੂਰਖ ਲੋਗ ਅਜਾਨ ॥"
    },
    {
      "ang": 1427,
      "sourceRow": 38,
      "sourceAngLine": 19,
      "text": "ਕਹੁ ਨਾਨਕ ਬਿਨੁ ਹਰਿ ਭਜਨ ਬਿਰਥਾ ਜਨਮੁ ਸਿਰਾਨ ॥੨੮॥"
    },
    {
      "ang": 1427,
      "sourceRow": 39,
      "sourceAngLine": 19,
      "text": "ਜੋ ਪ੍ਰਾਨੀ ਨਿਸਿ ਦਿਨੁ ਭਜੈ ਰੂਪ ਰਾਮ ਤਿਹ ਜਾਨੁ ॥"
    },
    {
      "ang": 1428,
      "sourceRow": 1,
      "sourceAngLine": 1,
      "text": "ਹਰਿ ਜਨ ਹਰਿ ਅੰਤਰੁ ਨਹੀ ਨਾਨਕ ਸਾਚੀ ਮਾਨੁ ॥੨੯॥"
    },
    {
      "ang": 1428,
      "sourceRow": 2,
      "sourceAngLine": 1,
      "text": "ਮਨੁ ਮਾਇਆ ਮੈ ਫਧਿ ਰਹਿਓ ਬਿਸਰਿਓ ਗੋਬਿੰਦ ਨਾਮੁ ॥"
    },
    {
      "ang": 1428,
      "sourceRow": 3,
      "sourceAngLine": 2,
      "text": "ਕਹੁ ਨਾਨਕ ਬਿਨੁ ਹਰਿ ਭਜਨ ਜੀਵਨ ਕਉਨੇ ਕਾਮ ॥੩੦॥"
    },
    {
      "ang": 1428,
      "sourceRow": 4,
      "sourceAngLine": 2,
      "text": "ਪ੍ਰਾਨੀ ਰਾਮੁ ਨ ਚੇਤਈ ਮਦਿ ਮਾਇਆ ਕੈ ਅੰਧੁ ॥"
    },
    {
      "ang": 1428,
      "sourceRow": 5,
      "sourceAngLine": 3,
      "text": "ਕਹੁ ਨਾਨਕ ਹਰਿ ਭਜਨ ਬਿਨੁ ਪਰਤ ਤਾਹਿ ਜਮ ਫੰਧ ॥੩੧॥"
    },
    {
      "ang": 1428,
      "sourceRow": 6,
      "sourceAngLine": 3,
      "text": "ਸੁਖ ਮੈ ਬਹੁ ਸੰਗੀ ਭਏ ਦੁਖ ਮੈ ਸੰਗਿ ਨ ਕੋਇ ॥"
    },
    {
      "ang": 1428,
      "sourceRow": 7,
      "sourceAngLine": 4,
      "text": "ਕਹੁ ਨਾਨਕ ਹਰਿ ਭਜੁ ਮਨਾ ਅੰਤਿ ਸਹਾਈ ਹੋਇ ॥੩੨॥"
    },
    {
      "ang": 1428,
      "sourceRow": 8,
      "sourceAngLine": 4,
      "text": "ਜਨਮ ਜਨਮ ਭਰਮਤ ਫਿਰਿਓ ਮਿਟਿਓ ਨ ਜਮ ਕੋ ਤ੍ਰਾਸੁ ॥"
    },
    {
      "ang": 1428,
      "sourceRow": 9,
      "sourceAngLine": 5,
      "text": "ਕਹੁ ਨਾਨਕ ਹਰਿ ਭਜੁ ਮਨਾ ਨਿਰਭੈ ਪਾਵਹਿ ਬਾਸੁ ॥੩੩॥"
    },
    {
      "ang": 1428,
      "sourceRow": 10,
      "sourceAngLine": 5,
      "text": "ਜਤਨ ਬਹੁਤੁ ਮੈ ਕਰਿ ਰਹਿਓ ਮਿਟਿਓ ਨ ਮਨ ਕੋ ਮਾਨੁ ॥"
    },
    {
      "ang": 1428,
      "sourceRow": 11,
      "sourceAngLine": 6,
      "text": "ਦੁਰਮਤਿ ਸਿਉ ਨਾਨਕ ਫਧਿਓ ਰਾਖਿ ਲੇਹੁ ਭਗਵਾਨ ॥੩੪॥"
    },
    {
      "ang": 1428,
      "sourceRow": 12,
      "sourceAngLine": 7,
      "text": "ਬਾਲ ਜੁਆਨੀ ਅਰੁ ਬਿਰਧਿ ਫੁਨਿ ਤੀਨਿ ਅਵਸਥਾ ਜਾਨਿ ॥"
    },
    {
      "ang": 1428,
      "sourceRow": 13,
      "sourceAngLine": 7,
      "text": "ਕਹੁ ਨਾਨਕ ਹਰਿ ਭਜਨ ਬਿਨੁ ਬਿਰਥਾ ਸਭ ਹੀ ਮਾਨੁ ॥੩੫॥"
    },
    {
      "ang": 1428,
      "sourceRow": 14,
      "sourceAngLine": 8,
      "text": "ਕਰਣੋ ਹੁਤੋ ਸੁ ਨਾ ਕੀਓ ਪਰਿਓ ਲੋਭ ਕੈ ਫੰਧ ॥"
    },
    {
      "ang": 1428,
      "sourceRow": 15,
      "sourceAngLine": 8,
      "text": "ਨਾਨਕ ਸਮਿਓ ਰਮਿ ਗਇਓ ਅਬ ਕਿਉ ਰੋਵਤ ਅੰਧ ॥੩੬॥"
    },
    {
      "ang": 1428,
      "sourceRow": 16,
      "sourceAngLine": 9,
      "text": "ਮਨੁ ਮਾਇਆ ਮੈ ਰਮਿ ਰਹਿਓ ਨਿਕਸਤ ਨਾਹਿਨ ਮੀਤ ॥"
    },
    {
      "ang": 1428,
      "sourceRow": 17,
      "sourceAngLine": 9,
      "text": "ਨਾਨਕ ਮੂਰਤਿ ਚਿਤ੍ਰ ਜਿਉ ਛਾਡਿਤ ਨਾਹਿਨ ਭੀਤਿ ॥੩੭॥"
    },
    {
      "ang": 1428,
      "sourceRow": 18,
      "sourceAngLine": 10,
      "text": "ਨਰ ਚਾਹਤ ਕਛੁ ਅਉਰ ਅਉਰੈ ਕੀ ਅਉਰੈ ਭਈ ॥"
    },
    {
      "ang": 1428,
      "sourceRow": 19,
      "sourceAngLine": 10,
      "text": "ਚਿਤਵਤ ਰਹਿਓ ਠਗਉਰ ਨਾਨਕ ਫਾਸੀ ਗਲਿ ਪਰੀ ॥੩੮॥"
    },
    {
      "ang": 1428,
      "sourceRow": 20,
      "sourceAngLine": 11,
      "text": "ਜਤਨ ਬਹੁਤ ਸੁਖ ਕੇ ਕੀਏ ਦੁਖ ਕੋ ਕੀਓ ਨ ਕੋਇ ॥"
    },
    {
      "ang": 1428,
      "sourceRow": 21,
      "sourceAngLine": 11,
      "text": "ਕਹੁ ਨਾਨਕ ਸੁਨਿ ਰੇ ਮਨਾ ਹਰਿ ਭਾਵੈ ਸੋ ਹੋਇ ॥੩੯॥"
    },
    {
      "ang": 1428,
      "sourceRow": 22,
      "sourceAngLine": 12,
      "text": "ਜਗਤੁ ਭਿਖਾਰੀ ਫਿਰਤੁ ਹੈ ਸਭ ਕੋ ਦਾਤਾ ਰਾਮੁ ॥"
    },
    {
      "ang": 1428,
      "sourceRow": 23,
      "sourceAngLine": 12,
      "text": "ਕਹੁ ਨਾਨਕ ਮਨ ਸਿਮਰੁ ਤਿਹ ਪੂਰਨ ਹੋਵਹਿ ਕਾਮ ॥੪੦॥"
    },
    {
      "ang": 1428,
      "sourceRow": 24,
      "sourceAngLine": 13,
      "text": "ਝੂਠੈ ਮਾਨੁ ਕਹਾ ਕਰੈ ਜਗੁ ਸੁਪਨੇ ਜਿਉ ਜਾਨੁ ॥"
    },
    {
      "ang": 1428,
      "sourceRow": 25,
      "sourceAngLine": 13,
      "text": "ਇਨ ਮੈ ਕਛੁ ਤੇਰੋ ਨਹੀ ਨਾਨਕ ਕਹਿਓ ਬਖਾਨਿ ॥੪੧॥"
    },
    {
      "ang": 1428,
      "sourceRow": 26,
      "sourceAngLine": 13,
      "text": "ਗਰਬੁ ਕਰਤੁ ਹੈ ਦੇਹ ਕੋ ਬਿਨਸੈ ਛਿਨ ਮੈ ਮੀਤ ॥"
    },
    {
      "ang": 1428,
      "sourceRow": 27,
      "sourceAngLine": 14,
      "text": "ਜਿਹਿ ਪ੍ਰਾਨੀ ਹਰਿ ਜਸੁ ਕਹਿਓ ਨਾਨਕ ਤਿਹਿ ਜਗੁ ਜੀਤਿ ॥੪੨॥"
    },
    {
      "ang": 1428,
      "sourceRow": 28,
      "sourceAngLine": 14,
      "text": "ਜਿਹ ਘਟਿ ਸਿਮਰਨੁ ਰਾਮ ਕੋ ਸੋ ਨਰੁ ਮੁਕਤਾ ਜਾਨੁ ॥"
    },
    {
      "ang": 1428,
      "sourceRow": 29,
      "sourceAngLine": 15,
      "text": "ਤਿਹਿ ਨਰ ਹਰਿ ਅੰਤਰੁ ਨਹੀ ਨਾਨਕ ਸਾਚੀ ਮਾਨੁ ॥੪੩॥"
    },
    {
      "ang": 1428,
      "sourceRow": 30,
      "sourceAngLine": 15,
      "text": "ਏਕ ਭਗਤਿ ਭਗਵਾਨ ਜਿਹ ਪ੍ਰਾਨੀ ਕੈ ਨਾਹਿ ਮਨਿ ॥"
    },
    {
      "ang": 1428,
      "sourceRow": 31,
      "sourceAngLine": 16,
      "text": "ਜੈਸੇ ਸੂਕਰ ਸੁਆਨ ਨਾਨਕ ਮਾਨੋ ਤਾਹਿ ਤਨੁ ॥੪੪॥"
    },
    {
      "ang": 1428,
      "sourceRow": 32,
      "sourceAngLine": 16,
      "text": "ਸੁਆਮੀ ਕੋ ਗ੍ਰਿਹੁ ਜਿਉ ਸਦਾ ਸੁਆਨ ਤਜਤ ਨਹੀ ਨਿਤ ॥"
    },
    {
      "ang": 1428,
      "sourceRow": 33,
      "sourceAngLine": 17,
      "text": "ਨਾਨਕ ਇਹ ਬਿਧਿ ਹਰਿ ਭਜਉ ਇਕ ਮਨਿ ਹੁਇ ਇਕ ਚਿਤਿ ॥੪੫॥"
    },
    {
      "ang": 1428,
      "sourceRow": 34,
      "sourceAngLine": 18,
      "text": "ਤੀਰਥ ਬਰਤ ਅਰੁ ਦਾਨ ਕਰਿ ਮਨ ਮੈ ਧਰੈ ਗੁਮਾਨੁ ॥"
    },
    {
      "ang": 1428,
      "sourceRow": 35,
      "sourceAngLine": 18,
      "text": "ਨਾਨਕ ਨਿਹਫਲ ਜਾਤ ਤਿਹ ਜਿਉ ਕੁੰਚਰ ਇਸਨਾਨੁ ॥੪੬॥"
    },
    {
      "ang": 1428,
      "sourceRow": 36,
      "sourceAngLine": 18,
      "text": "ਸਿਰੁ ਕੰਪਿਓ ਪਗ ਡਗਮਗੇ ਨੈਨ ਜੋਤਿ ਤੇ ਹੀਨ ॥"
    },
    {
      "ang": 1428,
      "sourceRow": 37,
      "sourceAngLine": 18,
      "text": "ਕਹੁ ਨਾਨਕ ਇਹ ਬਿਧਿ ਭਈ ਤਊ ਨ ਹਰਿ ਰਸਿ ਲੀਨ ॥੪੭॥"
    },
    {
      "ang": 1429,
      "sourceRow": 1,
      "sourceAngLine": 1,
      "text": "ਨਿਜ ਕਰਿ ਦੇਖਿਓ ਜਗਤੁ ਮੈ ਕੋ ਕਾਹੂ ਕੋ ਨਾਹਿ ॥"
    },
    {
      "ang": 1429,
      "sourceRow": 2,
      "sourceAngLine": 1,
      "text": "ਨਾਨਕ ਥਿਰੁ ਹਰਿ ਭਗਤਿ ਹੈ ਤਿਹ ਰਾਖੋ ਮਨ ਮਾਹਿ ॥੪੮॥"
    },
    {
      "ang": 1429,
      "sourceRow": 3,
      "sourceAngLine": 2,
      "text": "ਜਗ ਰਚਨਾ ਸਭ ਝੂਠ ਹੈ ਜਾਨਿ ਲੇਹੁ ਰੇ ਮੀਤ ॥"
    },
    {
      "ang": 1429,
      "sourceRow": 4,
      "sourceAngLine": 2,
      "text": "ਕਹਿ ਨਾਨਕ ਥਿਰੁ ਨਾ ਰਹੈ ਜਿਉ ਬਾਲੂ ਕੀ ਭੀਤਿ ॥੪੯॥"
    },
    {
      "ang": 1429,
      "sourceRow": 5,
      "sourceAngLine": 3,
      "text": "ਰਾਮੁ ਗਇਓ ਰਾਵਨੁ ਗਇਓ ਜਾ ਕਉ ਬਹੁ ਪਰਵਾਰੁ ॥"
    },
    {
      "ang": 1429,
      "sourceRow": 6,
      "sourceAngLine": 3,
      "text": "ਕਹੁ ਨਾਨਕ ਥਿਰੁ ਕਛੁ ਨਹੀ ਸੁਪਨੇ ਜਿਉ ਸੰਸਾਰੁ ॥੫੦॥"
    },
    {
      "ang": 1429,
      "sourceRow": 7,
      "sourceAngLine": 4,
      "text": "ਚਿੰਤਾ ਤਾ ਕੀ ਕੀਜੀਐ ਜੋ ਅਨਹੋਨੀ ਹੋਇ ॥"
    },
    {
      "ang": 1429,
      "sourceRow": 8,
      "sourceAngLine": 4,
      "text": "ਇਹੁ ਮਾਰਗੁ ਸੰਸਾਰ ਕੋ ਨਾਨਕ ਥਿਰੁ ਨਹੀ ਕੋਇ ॥੫੧॥"
    },
    {
      "ang": 1429,
      "sourceRow": 9,
      "sourceAngLine": 4,
      "text": "ਜੋ ਉਪਜਿਓ ਸੋ ਬਿਨਸਿ ਹੈ ਪਰੋ ਆਜੁ ਕੈ ਕਾਲਿ ॥"
    },
    {
      "ang": 1429,
      "sourceRow": 10,
      "sourceAngLine": 5,
      "text": "ਨਾਨਕ ਹਰਿ ਗੁਨ ਗਾਇ ਲੇ ਛਾਡਿ ਸਗਲ ਜੰਜਾਲ ॥੫੨॥"
    },
    {
      "ang": 1429,
      "sourceRow": 11,
      "sourceAngLine": 5,
      "text": "ਦੋਹਰਾ ॥"
    },
    {
      "ang": 1429,
      "sourceRow": 12,
      "sourceAngLine": 6,
      "text": "ਬਲੁ ਛੁਟਕਿਓ ਬੰਧਨ ਪਰੇ ਕਛੂ ਨ ਹੋਤ ਉਪਾਇ ॥"
    },
    {
      "ang": 1429,
      "sourceRow": 13,
      "sourceAngLine": 6,
      "text": "ਕਹੁ ਨਾਨਕ ਅਬ ਓਟ ਹਰਿ ਗਜ ਜਿਉ ਹੋਹੁ ਸਹਾਇ ॥੫੩॥"
    },
    {
      "ang": 1429,
      "sourceRow": 14,
      "sourceAngLine": 7,
      "text": "ਬਲੁ ਹੋਆ ਬੰਧਨ ਛੁਟੇ ਸਭੁ ਕਿਛੁ ਹੋਤ ਉਪਾਇ ॥"
    },
    {
      "ang": 1429,
      "sourceRow": 15,
      "sourceAngLine": 7,
      "text": "ਨਾਨਕ ਸਭੁ ਕਿਛੁ ਤੁਮਰੈ ਹਾਥ ਮੈ ਤੁਮ ਹੀ ਹੋਤ ਸਹਾਇ ॥੫੪॥"
    },
    {
      "ang": 1429,
      "sourceRow": 16,
      "sourceAngLine": 8,
      "text": "ਸੰਗ ਸਖਾ ਸਭਿ ਤਜਿ ਗਏ ਕੋਊ ਨ ਨਿਬਹਿਓ ਸਾਥਿ ॥"
    },
    {
      "ang": 1429,
      "sourceRow": 17,
      "sourceAngLine": 8,
      "text": "ਕਹੁ ਨਾਨਕ ਇਹ ਬਿਪਤਿ ਮੈ ਟੇਕ ਏਕ ਰਘੁਨਾਥ ॥੫੫॥"
    },
    {
      "ang": 1429,
      "sourceRow": 18,
      "sourceAngLine": 9,
      "text": "ਨਾਮੁ ਰਹਿਓ ਸਾਧੂ ਰਹਿਓ ਰਹਿਓ ਗੁਰੁ ਗੋਬਿੰਦੁ ॥"
    },
    {
      "ang": 1429,
      "sourceRow": 19,
      "sourceAngLine": 9,
      "text": "ਕਹੁ ਨਾਨਕ ਇਹ ਜਗਤ ਮੈ ਕਿਨ ਜਪਿਓ ਗੁਰ ਮੰਤੁ ॥੫੬॥"
    },
    {
      "ang": 1429,
      "sourceRow": 20,
      "sourceAngLine": 10,
      "text": "ਰਾਮ ਨਾਮੁ ਉਰ ਮੈ ਗਹਿਓ ਜਾ ਕੈ ਸਮ ਨਹੀ ਕੋਇ ॥"
    },
    {
      "ang": 1429,
      "sourceRow": 21,
      "sourceAngLine": 10,
      "text": "ਜਿਹ ਸਿਮਰਤ ਸੰਕਟ ਮਿਟੈ ਦਰਸੁ ਤੁਹਾਰੋ ਹੋਇ ॥੫੭॥੧॥"
    }
  ],
  "preceding": {
    "ang": 1426,
    "sourceRow": 15,
    "sourceAngLine": 8,
    "text": "ਜਿਸੁ ਪਾਸਿ ਬਹਿਠਿਆ ਸੋਹੀਐ ਸਭਨਾਂ ਦਾ ਵੇਸਾਹੁ ॥੨੨॥"
  },
  "following": {
    "ang": 1429,
    "sourceRow": 22,
    "sourceAngLine": 11,
    "text": "ਮੁੰਦਾਵਣੀ ਮਹਲਾ ੫ ॥"
  },
