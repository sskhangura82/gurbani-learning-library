      "kind": "heading",
      "verseNumber": null,
      "text": "ਸਲੋਕੁ ਮਃ ੧ ॥",
      "textSha256": "6e968c5a21a65d7744fcd250441115c09f2b3fe684dc49ea55eb291fb1033b6c",
      "ang": 470,
      "ordinal": 29,
      "printedLine": 12,
      "sourceBlob": "be5797afa1105edd5a30d78297dc415dac4c0f7b",
      "sourcePath": "corpus/ang-0470.md"
    },
    {
      "id": "sggs.asa-di-vaar.pauri014.salok01.line01",
      "passageId": "sggs.asa-di-vaar.pauri014.salok01",
      "editionId": "edition.sggs.opengranth-34d2a7c",
      "kind": "verse",
      "verseNumber": 1,
      "text": "ਸਿੰਮਲ ਰੁਖੁ ਸਰਾਇਰਾ ਅਤਿ ਦੀਰਘ ਅਤਿ ਮੁਚੁ ॥",
      "textSha256": "0d6a6dae8b853848c826460d76c4642a6537ce047c8deeb56d668c7ea258a8dd",
      "ang": 470,
      "ordinal": 30,
      "printedLine": 12,
      "sourceBlob": "be5797afa1105edd5a30d78297dc415dac4c0f7b",
      "sourcePath": "corpus/ang-0470.md"
    },
    {
      "id": "sggs.asa-di-vaar.pauri014.salok01.line02",
      "passageId": "sggs.asa-di-vaar.pauri014.salok01",
      "editionId": "edition.sggs.opengranth-34d2a7c",
      "kind": "verse",
      "verseNumber": 2,
      "text": "ਓਇ ਜਿ ਆਵਹਿ ਆਸ ਕਰਿ ਜਾਹਿ ਨਿਰਾਸੇ ਕਿਤੁ ॥",
      "textSha256": "5d97d37972c5c1ba0dba24bf178a0adc22678e850470430b258fce1e1b526782",
      "ang": 470,
      "ordinal": 31,
      "printedLine": 12,
      "sourceBlob": "be5797afa1105edd5a30d78297dc415dac4c0f7b",
      "sourcePath": "corpus/ang-0470.md"
    },
    {
      "id": "sggs.asa-di-vaar.pauri014.salok01.line03",
      "passageId": "sggs.asa-di-vaar.pauri014.salok01",
      "editionId": "edition.sggs.opengranth-34d2a7c",
      "kind": "verse",
      "verseNumber": 3,
      "text": "ਫਲ ਫਿਕੇ ਫੁਲ ਬਕਬਕੇ ਕੰਮਿ ਨ ਆਵਹਿ ਪਤ ॥",
      "textSha256": "e3a2713764f4e1511821a98dfdfeb595ea3f4eefac5f0ffd82d219857ea70cae",
      "ang": 470,
      "ordinal": 32,
      "printedLine": 13,
      "sourceBlob": "be5797afa1105edd5a30d78297dc415dac4c0f7b",
      "sourcePath": "corpus/ang-0470.md"
    },
    {
      "id": "sggs.asa-di-vaar.pauri014.salok01.line04",
      "passageId": "sggs.asa-di-vaar.pauri014.salok01",
      "editionId": "edition.sggs.opengranth-34d2a7c",
      "kind": "verse",
      "verseNumber": 4,
      "text": "ਮਿਠਤੁ ਨੀਵੀ ਨਾਨਕਾ ਗੁਣ ਚੰਗਿਆਈਆ ਤਤੁ ॥",
      "textSha256": "81bd2d546e0710478991e0355535da210948f911aa239784ef11d8712dc60110",
      "ang": 470,
      "ordinal": 33,
      "printedLine": 13,
      "sourceBlob": "be5797afa1105edd5a30d78297dc415dac4c0f7b",
      "sourcePath": "corpus/ang-0470.md"
    },
    {
      "id": "sggs.asa-di-vaar.pauri014.salok01.line05",
      "passageId": "sggs.asa-di-vaar.pauri014.salok01",
      "editionId": "edition.sggs.opengranth-34d2a7c",
      "kind": "verse",
      "verseNumber": 5,
      "text": "ਸਭੁ ਕੋ ਨਿਵੈ ਆਪ ਕਉ ਪਰ ਕਉ ਨਿਵੈ ਨ ਕੋਇ ॥",
      "textSha256": "c8f4d940b37a04f9bd218966ff636b2236bc324e243eef86129fcafa0221c18d",
      "ang": 470,
      "ordinal": 34,
      "printedLine": 14,
      "sourceBlob": "be5797afa1105edd5a30d78297dc415dac4c0f7b",
      "sourcePath": "corpus/ang-0470.md"
    },
    {
      "id": "sggs.asa-di-vaar.pauri014.salok01.line06",
      "passageId": "sggs.asa-di-vaar.pauri014.salok01",
      "editionId": "edition.sggs.opengranth-34d2a7c",
      "kind": "verse",
      "verseNumber": 6,
      "text": "ਧਰਿ ਤਾਰਾਜੂ ਤੋਲੀਐ ਨਿਵੈ ਸੁ ਗਉਰਾ ਹੋਇ ॥",
      "textSha256": "001d6c14286fa99d3d218af7381960ad4d4f42bc8fbecfc7c2c80503de7836f1",
      "ang": 470,
      "ordinal": 35,
      "printedLine": 14,
      "sourceBlob": "be5797afa1105edd5a30d78297dc415dac4c0f7b",
      "sourcePath": "corpus/ang-0470.md"
    },
    {
      "id": "sggs.asa-di-vaar.pauri014.salok01.line07",
      "passageId": "sggs.asa-di-vaar.pauri014.salok01",
      "editionId": "edition.sggs.opengranth-34d2a7c",
      "kind": "verse",
      "verseNumber": 7,
      "text": "ਅਪਰਾਧੀ ਦੂਣਾ ਨਿਵੈ ਜੋ ਹੰਤਾ ਮਿਰਗਾਹਿ ॥",
      "textSha256": "81db1a207062dc1a5a4ce2c769f59a433c8366c9a4a5b187392a21b4e6acc4d7",
      "ang": 470,
      "ordinal": 36,
      "printedLine": 15,
      "sourceBlob": "be5797afa1105edd5a30d78297dc415dac4c0f7b",
      "sourcePath": "corpus/ang-0470.md"
    },
    {
      "id": "sggs.asa-di-vaar.pauri014.salok01.line08",
      "passageId": "sggs.asa-di-vaar.pauri014.salok01",
      "editionId": "edition.sggs.opengranth-34d2a7c",
      "kind": "verse",
      "verseNumber": 8,
      "text": "ਸੀਸਿ ਨਿਵਾਇਐ ਕਿਆ ਥੀਐ ਜਾ ਰਿਦੈ ਕੁਸੁਧੇ ਜਾਹਿ ॥੧॥",
      "textSha256": "6fe904f500dad07f5a35b488edcca62f92502e9ed5f8f4c2ee1f091c1a33311a",
      "ang": 470,
      "ordinal": 37,
      "printedLine": 15,
      "sourceBlob": "be5797afa1105edd5a30d78297dc415dac4c0f7b",
      "sourcePath": "corpus/ang-0470.md"
    },
    {
      "id": "sggs.asa-di-vaar.pauri007.salok02.heading01",
      "passageId": "sggs.asa-di-vaar.pauri007.salok02",
      "editionId": "edition.sggs.opengranth-34d2a7c",
      "kind": "heading",
      "verseNumber": null,
      "text": "ਮਹਲਾ ੨ ॥",
      "textSha256": "bbefd1192b67d467c834fa58e804ee9eed84be079f8d7d08e33f99d0231791ff",
      "ang": 466,
      "ordinal": 40,
      "printedLine": 16,
      "sourceBlob": "28bc6a29e9e69341aec0590ee31329d70bdedb21",
      "sourcePath": "corpus/ang-0466.md"
    },
    {
      "id": "sggs.asa-di-vaar.pauri007.salok02.line01",
      "passageId": "sggs.asa-di-vaar.pauri007.salok02",
      "editionId": "edition.sggs.opengranth-34d2a7c",
      "kind": "verse",
      "verseNumber": 1,
      "text": "ਹਉਮੈ ਏਹਾ ਜਾਤਿ ਹੈ ਹਉਮੈ ਕਰਮ ਕਮਾਹਿ ॥",
      "textSha256": "cd027e5b507f13185c3bd65a832ed5c172012afba19c81ce7c46f5686173902f",
      "ang": 466,
      "ordinal": 41,
      "printedLine": 16,
      "sourceBlob": "28bc6a29e9e69341aec0590ee31329d70bdedb21",
      "sourcePath": "corpus/ang-0466.md"
    },
    {
      "id": "sggs.asa-di-vaar.pauri007.salok02.line02",
      "passageId": "sggs.asa-di-vaar.pauri007.salok02",
      "editionId": "edition.sggs.opengranth-34d2a7c",
      "kind": "verse",
      "verseNumber": 2,
      "text": "ਹਉਮੈ ਏਈ ਬੰਧਨਾ ਫਿਰਿ ਫਿਰਿ ਜੋਨੀ ਪਾਹਿ ॥",
      "textSha256": "156e618cfded18d00999cb1e6a76da2e9918f2e0ba46d609581df7a8aea8de27",
      "ang": 466,
      "ordinal": 42,
      "printedLine": 17,
      "sourceBlob": "28bc6a29e9e69341aec0590ee31329d70bdedb21",
      "sourcePath": "corpus/ang-0466.md"
    },
    {
      "id": "sggs.asa-di-vaar.pauri007.salok02.line03",
      "passageId": "sggs.asa-di-vaar.pauri007.salok02",
      "editionId": "edition.sggs.opengranth-34d2a7c",
      "kind": "verse",
      "verseNumber": 3,
      "text": "ਹਉਮੈ ਕਿਥਹੁ ਊਪਜੈ ਕਿਤੁ ਸੰਜਮਿ ਇਹ ਜਾਇ ॥",
      "textSha256": "f130b5946d387fdcf2704ee52df4853358af1091042f69d5e449864d6e88f34c",
      "ang": 466,
      "ordinal": 43,
      "printedLine": 17,
      "sourceBlob": "28bc6a29e9e69341aec0590ee31329d70bdedb21",
      "sourcePath": "corpus/ang-0466.md"
    },
    {
      "id": "sggs.asa-di-vaar.pauri007.salok02.line04",
      "passageId": "sggs.asa-di-vaar.pauri007.salok02",
      "editionId": "edition.sggs.opengranth-34d2a7c",
      "kind": "verse",
      "verseNumber": 4,
      "text": "ਹਉਮੈ ਏਹੋ ਹੁਕਮੁ ਹੈ ਪਇਐ ਕਿਰਤਿ ਫਿਰਾਹਿ ॥",
      "textSha256": "42be81ae229251e3b2ca6e46179e7221a9e990790f7c06ef29250e69e9e795f5",
      "ang": 466,
      "ordinal": 44,
      "printedLine": 17,
      "sourceBlob": "28bc6a29e9e69341aec0590ee31329d70bdedb21",
      "sourcePath": "corpus/ang-0466.md"
    },
    {
      "id": "sggs.asa-di-vaar.pauri007.salok02.line05",
      "passageId": "sggs.asa-di-vaar.pauri007.salok02",
      "editionId": "edition.sggs.opengranth-34d2a7c",
      "kind": "verse",
      "verseNumber": 5,
      "text": "ਹਉਮੈ ਦੀਰਘ ਰੋਗੁ ਹੈ ਦਾਰੂ ਭੀ ਇਸੁ ਮਾਹਿ ॥",
      "textSha256": "0c509888865797ef284c3901ac5e378a9fbf791374bf5bc66c85b35759013465",
      "ang": 466,
      "ordinal": 45,
      "printedLine": 18,
      "sourceBlob": "28bc6a29e9e69341aec0590ee31329d70bdedb21",
      "sourcePath": "corpus/ang-0466.md"
    },
    {
      "id": "sggs.asa-di-vaar.pauri007.salok02.line06",
      "passageId": "sggs.asa-di-vaar.pauri007.salok02",
      "editionId": "edition.sggs.opengranth-34d2a7c",
      "kind": "verse",
      "verseNumber": 6,
      "text": "ਕਿਰਪਾ ਕਰੇ ਜੇ ਆਪਣੀ ਤਾ ਗੁਰ ਕਾ ਸਬਦੁ ਕਮਾਹਿ ॥",
      "textSha256": "0943d976f77b081b3c4794daaebc3d48a95207223f3ff1c014ffe577f5c38cb9",
      "ang": 466,
      "ordinal": 46,
      "printedLine": 18,
      "sourceBlob": "28bc6a29e9e69341aec0590ee31329d70bdedb21",
      "sourcePath": "corpus/ang-0466.md"
    },
    {
      "id": "sggs.asa-di-vaar.pauri007.salok02.line07",
      "passageId": "sggs.asa-di-vaar.pauri007.salok02",
      "editionId": "edition.sggs.opengranth-34d2a7c",
      "kind": "verse",
      "verseNumber": 7,
      "text": "ਨਾਨਕੁ ਕਹੈ ਸੁਣਹੁ ਜਨਹੁ ਇਤੁ ਸੰਜਮਿ ਦੁਖ ਜਾਹਿ ॥੨॥",
      "textSha256": "ad50399eff2a4a182f6211e8ef0db40a8b7cd86fc2179daa7ba576430e3e98c5",
      "ang": 466,
      "ordinal": 47,
      "printedLine": 19,
      "sourceBlob": "28bc6a29e9e69341aec0590ee31329d70bdedb21",
      "sourcePath": "corpus/ang-0466.md"
    },
    {
      "id": "sggs.kabir.salok007.line01",
      "passageId": "sggs.kabir.salok007",
      "editionId": "edition.sggs.opengranth-34d2a7c",
      "kind": "verse",
      "verseNumber": 1,
      "text": "ਕਬੀਰ ਸਭ ਤੇ ਹਮ ਬੁਰੇ ਹਮ ਤਜਿ ਭਲੋ ਸਭੁ ਕੋਇ ॥",
      "textSha256": "8ba0a6d453d062901d3bb8fe59d073c5598a02374432f65622c55e435ff3262f",
      "ang": 1364,
      "ordinal": 33,
      "printedLine": 16,
      "sourceBlob": "9e5f1d8215e1a817adc9465a861bdb4b75b9d153",
      "sourcePath": "corpus/ang-1364.md"
    },
    {
      "id": "sggs.kabir.salok007.line02",
      "passageId": "sggs.kabir.salok007",
      "editionId": "edition.sggs.opengranth-34d2a7c",
      "kind": "verse",
      "verseNumber": 2,
      "text": "ਜਿਨਿ ਐਸਾ ਕਰਿ ਬੂਝਿਆ ਮੀਤੁ ਹਮਾਰਾ ਸੋਇ ॥੭॥",
      "textSha256": "a47294939805babef2cd4b4360c85e2a16f96403951be0a300e7c068dd76ad87",
      "ang": 1364,
      "ordinal": 34,
