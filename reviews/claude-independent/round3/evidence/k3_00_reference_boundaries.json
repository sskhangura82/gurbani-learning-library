   "lines": [
    {
     "id": "KVTT",
     "n": 1,
     "page": 466,
     "line": 7,
     "raw": "ਪਉੜੀ ॥"
    },
    {
     "id": "ECF9",
     "n": 2,
     "page": 466,
     "line": 7,
     "raw": "ਬਿਨੁ ਸਤਿਗੁਰ. ਕਿਨੈ ਨ ਪਾਇਓ; ਬਿਨੁ ਸਤਿਗੁਰ. ਕਿਨੈ ਨ ਪਾਇਆ ॥"
    },
    {
     "id": "J8C9",
     "n": 3,
     "page": 466,
     "line": 8,
     "raw": "ਸਤਿਗੁਰ ਵਿਚਿ. ਆਪੁ ਰਖਿਓਨੁ; ਕਰਿ ਪਰਗਟੁ. ਆਖਿ ਸੁਣਾਇਆ ॥"
    },
    {
     "id": "DJNC",
     "n": 4,
     "page": 466,
     "line": 8,
     "raw": "ਸਤਿਗੁਰ ਮਿਲਿਐ. ਸਦਾ ਮੁਕਤੁ ਹੈ; ਜਿਨਿ ਵਿਚਹੁ ਮੋਹੁ ਚੁਕਾਇਆ ॥"
    },
    {
     "id": "EZ5K",
     "n": 5,
     "page": 466,
     "line": 9,
     "raw": "ਉਤਮੁ ਏਹੁ ਬੀਚਾਰੁ ਹੈ; ਜਿਨਿ. ਸਚੇ ਸਿਉ ਚਿਤੁ ਲਾਇਆ ॥"
    },
    {
     "id": "USJC",
     "n": 6,
     "page": 466,
     "line": 10,
     "raw": "ਜਗਜੀਵਨੁ ਦਾਤਾ; ਪਾਇਆ ॥੬॥"
    }
   ],
   "pages": [
