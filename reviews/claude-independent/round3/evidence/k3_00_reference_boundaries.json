     "raw": "ਸਲੋਕ ਮਃ ੧ ॥"
    },
    {
     "id": "LVYD",
     "n": 2,
     "page": 466,
     "line": 10,
     "raw": "ਹਉ ਵਿਚਿ ਆਇਆ; ਹਉ ਵਿਚਿ ਗਇਆ ॥"
    },
    {
     "id": "2BJR",
     "n": 3,
     "page": 466,
     "line": 10,
     "raw": "ਹਉ ਵਿਚਿ ਜੰਮਿਆ; ਹਉ ਵਿਚਿ ਮੁਆ ॥"
    },
    {
     "id": "ZZ9C",
     "n": 4,
     "page": 466,
     "line": 11,
     "raw": "ਹਉ ਵਿਚਿ ਦਿਤਾ; ਹਉ ਵਿਚਿ ਲਇਆ ॥"
    },
    {
     "id": "9C0F",
     "n": 5,
     "page": 466,
     "line": 11,
     "raw": "ਹਉ ਵਿਚਿ ਖਟਿਆ; ਹਉ ਵਿਚਿ ਗਇਆ ॥"
    },
    {
     "id": "R989",
     "n": 6,
     "page": 466,
     "line": 12,
     "raw": "ਹਉ ਵਿਚਿ; ਸਚਿਆਰੁ ਕੂੜਿਆਰੁ ॥"
    },
    {
     "id": "0F2V",
     "n": 7,
     "page": 466,
     "line": 12,
     "raw": "ਹਉ ਵਿਚਿ; ਪਾਪ ਪੁੰਨ ਵੀਚਾਰੁ ॥"
    },
    {
     "id": "Y5P1",
     "n": 8,
     "page": 466,
     "line": 12,
     "raw": "ਹਉ ਵਿਚਿ; ਨਰਕਿ ਸੁਰਗਿ ਅਵਤਾਰੁ ॥"
    },
    {
     "id": "SGDK",
     "n": 9,
     "page": 466,
     "line": 12,
     "raw": "ਹਉ ਵਿਚਿ ਹਸੈ; ਹਉ ਵਿਚਿ ਰੋਵੈ ॥"
    },
    {
     "id": "SJ9B",
     "n": 10,
     "page": 466,
     "line": 13,
     "raw": "ਹਉ ਵਿਚਿ ਭਰੀਐ; ਹਉ ਵਿਚਿ ਧੋਵੈ ॥"
    },
    {
     "id": "2NRW",
     "n": 11,
     "page": 466,
     "line": 13,
     "raw": "ਹਉ ਵਿਚਿ; ਜਾਤੀ ਜਿਨਸੀ ਖੋਵੈ ॥"
    },
    {
     "id": "PBLW",
     "n": 12,
     "page": 466,
     "line": 13,
     "raw": "ਹਉ ਵਿਚਿ ਮੂਰਖੁ; ਹਉ ਵਿਚਿ ਸਿਆਣਾ ॥"
    },
    {
     "id": "XYW9",
     "n": 13,
     "page": 466,
     "line": 14,
     "raw": "ਮੋਖ ਮੁਕਤਿ ਕੀ; ਸਾਰ ਨ ਜਾਣਾ ॥"
    },
    {
     "id": "8459",
     "n": 14,
     "page": 466,
     "line": 14,
     "raw": "ਹਉ ਵਿਚਿ ਮਾਇਆ; ਹਉ ਵਿਚਿ ਛਾਇਆ ॥"
    },
    {
     "id": "ZRKP",
     "n": 15,
     "page": 466,
     "line": 15,
     "raw": "ਹਉਮੈ ਕਰਿ ਕਰਿ; ਜੰਤ ਉਪਾਇਆ ॥"
    },
    {
     "id": "S52L",
     "n": 16,
     "page": 466,
     "line": 15,
     "raw": "ਹਉਮੈ ਬੂਝੈ; ਤਾ ਦਰੁ ਸੂਝੈ ॥"
    },
    {
     "id": "CLBJ",
     "n": 17,
     "page": 466,
     "line": 15,
     "raw": "ਗਿਆਨ ਵਿਹੂਣਾ; ਕਥਿ ਕਥਿ ਲੂਝੈ ॥"
    },
    {
     "id": "84H3",
     "n": 18,
     "page": 466,
     "line": 15,
     "raw": "ਨਾਨਕ. ਹੁਕਮੀ; ਲਿਖੀਐ ਲੇਖੁ ॥"
    },
    {
     "id": "91YV",
     "n": 19,
     "page": 466,
     "line": 16,
     "raw": "ਜੇਹਾ ਵੇਖਹਿ; ਤੇਹਾ ਵੇਖੁ ॥੧॥"
    }
   ],
