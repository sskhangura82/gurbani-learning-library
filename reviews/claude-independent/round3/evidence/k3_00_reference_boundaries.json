   "lines": [
    {
     "id": "DGUG",
     "n": 1,
     "page": 465,
     "line": 17,
     "raw": "ਸਲੋਕ ਮਃ ੧ ॥"
    },
    {
     "id": "QQUJ",
     "n": 2,
     "page": 465,
     "line": 17,
     "raw": "ਮੁਸਲਮਾਨਾ. ਸਿਫਤਿ ਸਰੀਅਤਿ; ਪੜਿ ਪੜਿ ਕਰਹਿ ਬੀਚਾਰੁ ॥"
    },
    {
     "id": "6ZVX",
     "n": 3,
     "page": 465,
     "line": 18,
     "raw": "ਬੰਦੇ ਸੇ. ਜਿ ਪਵਹਿ ਵਿਚਿ ਬੰਦੀ; ਵੇਖਣ ਕਉ ਦੀਦਾਰੁ ॥"
    },
    {
     "id": "EBA7",
     "n": 4,
     "page": 465,
     "line": 18,
     "raw": "ਹਿੰਦੂ ਸਾਲਾਹੀ ਸਾਲਾਹਨਿ; ਦਰਸਨਿ ਰੂਪਿ ਅਪਾਰੁ ॥"
    },
    {
     "id": "V3XM",
     "n": 5,
     "page": 465,
     "line": 19,
     "raw": "ਤੀਰਥਿ ਨਾਵਹਿ, ਅਰਚਾ ਪੂਜਾ; ਅਗਰ ਵਾਸੁ ਬਹਕਾਰੁ ॥"
    },
    {
     "id": "1F9L",
     "n": 6,
     "page": 465,
     "line": 19,
     "raw": "ਜੋਗੀ ਸੁੰਨਿ ਧਿਆਵਨੑਿ ਜੇਤੇ; ਅਲਖ ਨਾਮੁ ਕਰਤਾਰੁ ॥"
    },
    {
     "id": "ARGD",
     "n": 7,
     "page": 466,
     "line": 1,
     "raw": "ਸੂਖਮ ਮੂਰਤਿ. ਨਾਮੁ ਨਿਰੰਜਨ; ਕਾਇਆ ਕਾ ਆਕਾਰੁ ॥"
    },
    {
     "id": "SA7X",
     "n": 8,
     "page": 466,
     "line": 1,
     "raw": "ਸਤੀਆ. ਮਨਿ ਸੰਤੋਖੁ ਉਪਜੈ; ਦੇਣੈ ਕੈ ਵੀਚਾਰਿ ॥"
    },
    {
     "id": "4ZZR",
     "n": 9,
     "page": 466,
     "line": 2,
     "raw": "ਦੇ ਦੇ ਮੰਗਹਿ, ਸਹਸਾ ਗੂਣਾ; ਸੋਭ ਕਰੇ ਸੰਸਾਰੁ ॥"
    },
    {
     "id": "BKC9",
     "n": 10,
     "page": 466,
     "line": 2,
     "raw": "ਚੋਰਾ ਜਾਰਾ ਤੈ ਕੂੜਿਆਰਾ; ਖਾਰਾਬਾ ਵੇਕਾਰ ॥"
    },
    {
     "id": "XKFQ",
     "n": 11,
     "page": 466,
     "line": 3,
     "raw": "ਇਕਿ. ਹੋਦਾ ਖਾਇ ਚਲਹਿ ਐਥਾਊ; ਤਿਨਾ ਭਿ ਕਾਈ ਕਾਰ ॥"
    },
    {
     "id": "JAEC",
     "n": 12,
     "page": 466,
     "line": 3,
     "raw": "ਜਲਿ ਥਲਿ ਜੀਆ ਪੁਰੀਆ ਲੋਆ; ਆਕਾਰਾ ਆਕਾਰ ॥"
    },
    {
     "id": "U97T",
     "n": 13,
     "page": 466,
     "line": 4,
     "raw": "ਓਇ ਜਿ ਆਖਹਿ. ਸੁ ਤੂੰਹੈ ਜਾਣਹਿ; ਤਿਨਾ ਭਿ. ਤੇਰੀ ਸਾਰ ॥"
    },
    {
     "id": "HNGA",
     "n": 14,
     "page": 466,
     "line": 4,
     "raw": "ਨਾਨਕ. ਭਗਤਾ ਭੁਖ ਸਾਲਾਹਣੁ; ਸਚੁ ਨਾਮੁ ਆਧਾਰੁ ॥"
    },
    {
     "id": "TVY1",
     "n": 15,
     "page": 466,
     "line": 5,
     "raw": "ਸਦਾ ਅਨੰਦਿ ਰਹਹਿ. ਦਿਨੁ ਰਾਤੀ; ਗੁਣਵੰਤਿਆ ਪਾ ਛਾਰੁ ॥੧॥"
    }
   ],
   "pages": [
    465,
