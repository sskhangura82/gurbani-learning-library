    "occurrences": [
      {
        "ang": 504,
        "ordinal": 30,
        "printedLine": 18,
        "text": "ਗੂਜਰੀ ਮਹਲਾ ੧ ॥",
        "id": "sggs.gujri.m1.ang504.shabad04.l00",
        "kind": "heading",
        "stanza": null
      },
      {
        "ang": 504,
        "ordinal": 31,
        "printedLine": 18,
        "text": "ਐ ਜੀ ਨਾ ਹਮ ਉਤਮ ਨੀਚ ਨ ਮਧਿਮ ਹਰਿ ਸਰਣਾਗਤਿ ਹਰਿ ਕੇ ਲੋਗ ॥",
        "id": "sggs.gujri.m1.ang504.shabad04.l01",
        "kind": "verse",
        "stanza": 1
      },
      {
        "ang": 504,
        "ordinal": 32,
        "printedLine": 19,
        "text": "ਨਾਮ ਰਤੇ ਕੇਵਲ ਬੈਰਾਗੀ ਸੋਗ ਬਿਜੋਗ ਬਿਸਰਜਿਤ ਰੋਗ ॥੧॥",
        "id": "sggs.gujri.m1.ang504.shabad04.l02",
        "kind": "verse",
        "stanza": 1
      },
      {
        "ang": 504,
        "ordinal": 33,
        "printedLine": 19,
        "text": "ਭਾਈ ਰੇ ਗੁਰ ਕਿਰਪਾ ਤੇ ਭਗਤਿ ਠਾਕੁਰ ਕੀ ॥",
        "id": "sggs.gujri.m1.ang504.shabad04.l03",
        "kind": "rahao",
        "stanza": "rahao"
      },
      {
        "ang": 505,
        "ordinal": 1,
        "printedLine": 1,
        "text": "ਸਤਿਗੁਰ ਵਾਕਿ ਹਿਰਦੈ ਹਰਿ ਨਿਰਮਲੁ ਨਾ ਜਮ ਕਾਣਿ ਨ ਜਮ ਕੀ ਬਾਕੀ ॥੧॥ ਰਹਾਉ ॥",
        "id": "sggs.gujri.m1.ang504.shabad04.l04",
        "kind": "rahao",
        "stanza": "rahao"
      },
      {
        "ang": 505,
        "ordinal": 2,
        "printedLine": 2,
        "text": "ਹਰਿ ਗੁਣ ਰਸਨ ਰਵਹਿ ਪ੍ਰਭ ਸੰਗੇ ਜੋ ਤਿਸੁ ਭਾਵੈ ਸਹਜਿ ਹਰੀ ॥",
        "id": "sggs.gujri.m1.ang504.shabad04.l05",
        "kind": "verse",
        "stanza": 2
      },
      {
        "ang": 505,
        "ordinal": 3,
        "printedLine": 2,
        "text": "ਬਿਨੁ ਹਰਿ ਨਾਮ ਬ੍ਰਿਥਾ ਜਗਿ ਜੀਵਨੁ ਹਰਿ ਬਿਨੁ ਨਿਹਫਲ ਮੇਕ ਘਰੀ ॥੨॥",
        "id": "sggs.gujri.m1.ang504.shabad04.l06",
        "kind": "verse",
        "stanza": 2
      },
      {
        "ang": 505,
        "ordinal": 4,
        "printedLine": 3,
        "text": "ਐ ਜੀ ਖੋਟੇ ਠਉਰ ਨਾਹੀ ਘਰਿ ਬਾਹਰਿ ਨਿੰਦਕ ਗਤਿ ਨਹੀ ਕਾਈ ॥",
        "id": "sggs.gujri.m1.ang504.shabad04.l07",
        "kind": "verse",
        "stanza": 3
      },
      {
        "ang": 505,
        "ordinal": 5,
        "printedLine": 4,
        "text": "ਰੋਸੁ ਕਰੈ ਪ੍ਰਭੁ ਬਖਸ ਨ ਮੇਟੈ ਨਿਤ ਨਿਤ ਚੜੈ ਸਵਾਈ ॥੩॥",
        "id": "sggs.gujri.m1.ang504.shabad04.l08",
        "kind": "verse",
        "stanza": 3
      },
      {
        "ang": 505,
        "ordinal": 6,
        "printedLine": 4,
        "text": "ਐ ਜੀ ਗੁਰ ਕੀ ਦਾਤਿ ਨ ਮੇਟੈ ਕੋਈ ਮੇਰੈ ਠਾਕੁਰਿ ਆਪਿ ਦਿਵਾਈ ॥",
        "id": "sggs.gujri.m1.ang504.shabad04.l09",
        "kind": "verse",
        "stanza": 4
      },
      {
        "ang": 505,
        "ordinal": 7,
        "printedLine": 5,
        "text": "ਨਿੰਦਕ ਨਰ ਕਾਲੇ ਮੁਖ ਨਿੰਦਾ ਜਿਨੑ ਗੁਰ ਕੀ ਦਾਤਿ ਨ ਭਾਈ ॥੪॥",
        "id": "sggs.gujri.m1.ang504.shabad04.l10",
        "kind": "verse",
        "stanza": 4
      },
      {
        "ang": 505,
        "ordinal": 8,
        "printedLine": 5,
        "text": "ਐ ਜੀ ਸਰਣਿ ਪਰੇ ਪ੍ਰਭੁ ਬਖਸਿ ਮਿਲਾਵੈ ਬਿਲਮ ਨ ਅਧੂਆ ਰਾਈ ॥",
        "id": "sggs.gujri.m1.ang504.shabad04.l11",
        "kind": "verse",
        "stanza": 5
      },
      {
        "ang": 505,
        "ordinal": 9,
        "printedLine": 6,
        "text": "ਆਨਦ ਮੂਲੁ ਨਾਥੁ ਸਿਰਿ ਨਾਥਾ ਸਤਿਗੁਰੁ ਮੇਲਿ ਮਿਲਾਈ ॥੫॥",
        "id": "sggs.gujri.m1.ang504.shabad04.l12",
        "kind": "verse",
        "stanza": 5
      },
      {
        "ang": 505,
        "ordinal": 10,
        "printedLine": 7,
        "text": "ਐ ਜੀ ਸਦਾ ਦਇਆਲੁ ਦਇਆ ਕਰਿ ਰਵਿਆ ਗੁਰਮਤਿ ਭ੍ਰਮਨਿ ਚੁਕਾਈ ॥",
        "id": "sggs.gujri.m1.ang504.shabad04.l13",
        "kind": "verse",
        "stanza": 6
      },
      {
        "ang": 505,
        "ordinal": 11,
        "printedLine": 7,
        "text": "ਪਾਰਸੁ ਭੇਟਿ ਕੰਚਨੁ ਧਾਤੁ ਹੋਈ ਸਤਸੰਗਤਿ ਕੀ ਵਡਿਆਈ ॥੬॥",
        "id": "sggs.gujri.m1.ang504.shabad04.l14",
        "kind": "verse",
        "stanza": 6
      },
      {
        "ang": 505,
        "ordinal": 12,
        "printedLine": 8,
        "text": "ਹਰਿ ਜਲੁ ਨਿਰਮਲੁ ਮਨੁ ਇਸਨਾਨੀ ਮਜਨੁ ਸਤਿਗੁਰੁ ਭਾਈ ॥",
        "id": "sggs.gujri.m1.ang504.shabad04.l15",
        "kind": "verse",
        "stanza": 7
      },
      {
        "ang": 505,
        "ordinal": 13,
        "printedLine": 8,
        "text": "ਪੁਨਰਪਿ ਜਨਮੁ ਨਾਹੀ ਜਨ ਸੰਗਤਿ ਜੋਤੀ ਜੋਤਿ ਮਿਲਾਈ ॥੭॥",
        "id": "sggs.gujri.m1.ang504.shabad04.l16",
        "kind": "verse",
        "stanza": 7
      },
      {
        "ang": 505,
        "ordinal": 14,
        "printedLine": 9,
        "text": "ਤੂੰ ਵਡ ਪੁਰਖੁ ਅਗੰਮ ਤਰੋਵਰੁ ਹਮ ਪੰਖੀ ਤੁਝ ਮਾਹੀ ॥",
        "id": "sggs.gujri.m1.ang504.shabad04.l17",
        "kind": "verse",
        "stanza": 8
      },
      {
        "ang": 505,
        "ordinal": 15,
        "printedLine": 10,
        "text": "ਨਾਨਕ ਨਾਮੁ ਨਿਰੰਜਨ ਦੀਜੈ ਜੁਗਿ ਜੁਗਿ ਸਬਦਿ ਸਲਾਹੀ ॥੮॥੪॥",
        "id": "sggs.gujri.m1.ang504.shabad04.l18",
        "kind": "verse",
        "stanza": 8
      }
    ]
  },
